# Copy to config.env and fill in. config.env is gitignored — never commit it.

# Tari network. Only esmeralda (testnet) has a configured default indexer.
NETWORK=esmeralda

# Public indexer URL for the network. Leave empty to use the SDK default.
OOTLE_INDEXER_URL=

# Published address of the ranked-voting template on this network.
# Example: template_1234... (hex after the underscore; use the full address from the
# wallet web UI after publishing the template).
TEMPLATE_ADDRESS=

# The initiator's wallet keys (hex, 32 bytes each). Generate with:
#   node -e "const {generateOotleSecretKey}=require('@tari-project/ootle-wasm');const k=generateOotleSecretKey();console.log(Buffer.from(k.owner_key).toString('hex'));console.log(Buffer.from(k.view_key).toString('hex'))"
# Leave empty on first run and the server will generate a fresh keypair and print it.
OWNER_KEY_HEX=
VIEW_KEY_HEX=

# HTTP port for the web app.
PORT=80

# Where election records are stored (gitignored).
DATA_FILE=/opt/rcv-web/elections.json